# Supabase project: mnrlpifaurqntjidbjmn.supabase.co
# Copy to .env.local for local development. Never commit real credentials.

# Public site + CRM auth
NEXT_PUBLIC_SUPABASE_URL=https://mnrlpifaurqntjidbjmn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE
NEXT_PUBLIC_SITE_URL=https://villamemaj-2026-website.vercel.app

# Server-only database access. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Email: queued messages remain pending until the provider and a verified sender are configured.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Villa Memaj <bookings@villamemaj.com>

# Protected dispatcher/cron route. Use a long random secret.
CRON_SECRET=

# Stripe: test mode first; never expose the secret or webhook key to browser code.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_LIVE_PAYMENTS_ENABLED=false

# Optional guest support AI. Configure only one provider to begin.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SUPPORT_RATE_LIMIT_SALT=

# Optional transactional SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional owner booking alerts: use Slack OR Twilio WhatsApp.
SLACK_WEBHOOK_URL=
TWILIO_WHATSAPP_FROM=
OWNER_WHATSAPP_TO=

# Optional affiliate tracking. Must be Villa Memaj's own approved Skyscanner/Impact ID.
SKYSCANNER_MEDIA_PARTNER_ID=

# Optional public property review listing. Admin editor also supports saving this URL.
NEXT_PUBLIC_BOOKING_REVIEW_URL=

# Optional Booking.com Guest Review API access; server-only, requires official approval.
BOOKING_REVIEW_API_TOKEN=
BOOKING_REVIEW_PROPERTY_ID=
