# --- Required (public site + CRM auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://mnrlpifaurqntjidbjmn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE

# --- Booking notification emails (optional; queued safely until configured) ---
# EMAIL_PROVIDER=resend        # resend = live sending, log = dry run (prints instead)
# RESEND_API_KEY=              # from resend.com/api-keys
# EMAIL_FROM=Villa Memaj <bookings@villamemaj.com>
#
# Needed by the dispatcher to drain the notification queue (never expose client-side):
# SUPABASE_SERVICE_ROLE_KEY=
#
# Protects /api/email/dispatch (cron and manual runs):
# CRON_SECRET=

# Stripe payments (test mode first; never expose either value to the browser)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
