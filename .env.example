# Supabase project: mnrlpifaurqntjidbjmn.supabase.co
# Copy this file to .env.local and fill in the values (already done locally).
# In Vercel, add every variable under Project Settings &#8212; Environment Variables.

# --- Required (public site + CRM auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://mnrlpifaurqntjidbjmn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE

# --- Booking notification emails (optional; queued safely until configured) ---
# EMAIL_PROVIDER=resend        # resend = live sending, log = dry run (prints instead)
# RESEND_API_KEY=              # from resend.com/api-keys
# EMAIL_FROM=Villa Memaj <bookings@villamemaj.com>
#
# Needed by the dispatcher to drain the notification queue (never expose client-side):
# SUPABASE_SERVICE_ROLE_KEY=
#
# Protects /api/email/dispatch (cron and manual runs):
# CRON_SECRET=

# Stripe payments (test mode first; never expose either value to the browser)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_SITE_URL=https://villamemaj-2026-website.vercel.app
# STRIPE_LIVE_PAYMENTS_ENABLED=false # set true only after owner approval and live-mode verification

 
# --- Transactional email delivery ---
# Use a verified domain/sender in Resend before changing EMAIL_PROVIDER to resend.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=Villa Memaj <bookings@your-verified-domain.example>

# --- Optional, consent-based SMS and WhatsApp ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+355...
# TWILIO_WHATSAPP_FROM=whatsapp:+...
# Business-initiated WhatsApp messages require an approved template outside the 24-hour window.
# Use a Twilio Content Template with one body placeholder {{1}} containing the notification text.
# TWILIO_WHATSAPP_TEMPLATE_SID=HX...

# --- Optional AI support and owner alerts ---
# OPENAI_API_KEY=
# GUEST_SUPPORT_AI_MODEL=gpt-4.1-mini
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Protects scheduled notification dispatch. Configure in Vercel, not source control.
# CRON_SECRET=
